@article{hou_distinct_2009,
	title = {Distinct {Gene} {Number}-{Genome} {Size} {Relationships} for {Eukaryotes} and {Non}-{Eukaryotes}: {Gene} {Content} {Estimation} for {Dinoflagellate} {Genomes}},
	volume = {4},
	shorttitle = {Distinct {Gene} {Number}-{Genome} {Size} {Relationships} for {Eukaryotes} and {Non}-{Eukaryotes}},
	url = {http://dx.doi.org/10.1371/journal.pone.0006978},
	doi = {10.1371/journal.pone.0006978},
	abstract = {The ability to predict gene content is highly desirable for characterization of not-yet sequenced genomes like those of dinoflagellates. Using data from completely sequenced and annotated genomes from phylogenetically diverse lineages, we investigated the relationship between gene content and genome size using regression analyses. Distinct relationships between log10-transformed protein-coding gene number (Y′) versus log10-transformed genome size (X′, genome size in kbp) were found for eukaryotes and non-eukaryotes. Eukaryotes best fit a logarithmic model, Y′ = ln(-46.200+22.678X′, whereas non-eukaryotes a linear model, Y′ = 0.045+0.977X′, both with high significance (p{\textless}0.001, R2{\textgreater}0.91). Total gene number shows similar trends in both groups to their respective protein coding regressions. The distinct correlations reflect lower and decreasing gene-coding percentages as genome size increases in eukaryotes (82\%–1\%) compared to higher and relatively stable percentages in prokaryotes and viruses (97\%–47\%). The eukaryotic regression models project that the smallest dinoflagellate genome (3×106 kbp) contains 38,188 protein-coding (40,086 total) genes and the largest (245×106 kbp) 87,688 protein-coding (92,013 total) genes, corresponding to 1.8\% and 0.05\% gene-coding percentages. These estimates do not likely represent extraordinarily high functional diversity of the encoded proteome but rather highly redundant genomes as evidenced by high gene copy numbers documented for various dinoflagellate species.},
	number = {9},
	urldate = {2014-07-30},
	journal = {PLoS ONE},
	author = {Hou, Yubo and Lin, Senjie},
	month = sep,
	year = {2009},
	pages = {e6978},
	file = {PLoS Full Text PDF:/Users/dmitry/Zotero/storage/3XCJ7HNJ/Hou and Lin - 2009 - Distinct Gene Number-Genome Size Relationships for.pdf:application/pdf;PLoS Snapshot:/Users/dmitry/Zotero/storage/VE576MFB/infodoi10.1371journal.pone.html:text/html},
}

@article{lynch_streamlining_2006,
	title = {Streamlining and {Simplification} of {Microbial} {Genome} {Architecture}},
	volume = {60},
	url = {http://dx.doi.org/10.1146/annurev.micro.60.080805.142300},
	doi = {10.1146/annurev.micro.60.080805.142300},
	abstract = {AbstractThe genomes of unicellular species, particularly prokaryotes, are greatly reduced in size and simplified in terms of gene structure relative to those of multicellular eukaryotes. Arguments proposed to explain this disparity include selection for metabolic efficiency and elevated rates of deletion in microbes, but the evidence in support of these hypotheses is at best equivocal. An alternative explanation based on fundamental population-genetic principles is proposed here. By increasing the mutational target sizes of associated genes, most forms of nonfunctional DNA are opposed by weak selection. Free-living microbial species have elevated effective population sizes, and the consequent reduction in the power of random genetic drift appears to be sufficient to enable natural selection to inhibit the accumulation of excess DNA. This hypothesis provides a potentially unifying explanation for the continuity in genomic scaling from prokaryotes to multicellular eukaryotes, the divergent patterns of mitochondrial evolution in animals and land plants, and various aspects of genomic modification in microbial endosymbionts.},
	number = {1},
	urldate = {2014-07-30},
	journal = {Annual Review of Microbiology},
	author = {Lynch, Michael},
	year = {2006},
	keywords = {genome evolution, genomic streamlining, Mutation, prokaryotes, random genetic drift, recombination},
	pages = {327--349},
	file = {Full Text PDF:/Users/dmitry/Zotero/storage/PXI5QWAR/Lynch - 2006 - Streamlining and Simplification of Microbial Genom.pdf:application/pdf},
}

