	year = {2011},
	pages = {236--247},
	file = {ScienceDirect Snapshot:/Users/dmitry/Zotero/storage/C8JS29IJ/S1473309910702644.html:text/html},
}

@article{klepac_towards_2013,
	title = {Towards the endgame and beyond: complexities and challenges for the elimination of infectious diseases},
