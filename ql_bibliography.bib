	publisher = {American Society for Cell Biology (lse)},
	author = {Stanhope, Liz and Ziegler, Laura and Haque, Tabassum and Le, Laura and Vinces, Marcelo and Davis, Gregory K. and Zieffler, Andrew and Brodfuehrer, Peter and Preest, Marion and M. Belitsky, Jason and Umbanhowar, Charles and Overvoorde, Paul J.},
	month = dec,
