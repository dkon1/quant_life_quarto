	keywords = {molecular biology, bifurcation, biochemical reaction networks, biochemistry, bistability, equilibria, generic bifurcations, Hopf bifurcation, limit cycles, molecular biophysics, oscillations, reaction kinetics, saddle node},
	pages = {135--141},
}

@article{qiao_bistability_2007,
	title = {Bistability and {Oscillations} in the {Huang}-{Ferrell} {Model} of {MAPK} {Signaling}},
	volume = {3},
	url = {http://dx.plos.org/10.1371/journal.pcbi.0030184},
